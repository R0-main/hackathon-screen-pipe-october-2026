{
  "name": "@brain/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "npm run build -w @brain/client --if-present && npm run build:mcp-apps",
    "dev": "next dev -p ${PORT:-3000}",
    "prebuild": "npm run build -w @brain/client --if-present && npm run build:mcp-apps && tsx scripts/migrate.ts --on-build",
    "build": "next build",
    "build:mcp-apps": "tsx scripts/build-mcp-apps.ts",
    "start": "next start -p ${PORT:-3000}",
    "seed": "tsx scripts/seed.ts",
    "simulate": "tsx scripts/simulate.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "smoke": "tsx scripts/smoke.ts",
    "eval": "tsx scripts/eval-search.ts",
    "embed": "tsx scripts/embed-backfill.ts",
    "db:migrate": "tsx scripts/migrate.ts",
    "test": "node --import tsx --test scripts/*.test.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@brain/core": "*",
    "@gsap/react": "^2.1.2",
    "@modelcontextprotocol/ext-apps": "^1.7.5",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.27",
    "next": "15.5.28",
    "postgres": "^3.4.9",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "three": "^0.170.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.10.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.170.0",
    "esbuild": "^0.28.2",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3"
  }
}
