# --- Stockage du cerveau ---
# Sans DATABASE_URL : stockage fichier local (.brain/brain.json), parfait pour la démo sur un laptop.
# Avec DATABASE_URL : Postgres (Supabase : Project Settings > Database > Connection string, mode "Transaction pooler").
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# BRAIN_DATA_DIR=.brain

# --- Claude (résumé d'état, onboarding) — optionnel : sans clé, heuristiques locales ---
# ANTHROPIC_API_KEY=sk-ant-...

# --- URL publique du dashboard (utilisée dans le prompt d'installation) ---
# BRAIN_PUBLIC_URL=https://cerveau.example.com

# --- Mode démo : boutons de connexion rapide sur /login (données fictives uniquement !) ---
# BRAIN_DEMO=1

# Fuseau horaire pour la détection d'automatisations
# BRAIN_TIMEZONE=Europe/Paris
