# --- Brain storage ---
# Without DATABASE_URL: local file storage (.brain/brain.json), perfect for the demo on a laptop.
# With DATABASE_URL: Postgres (Supabase: Project Settings > Database > Connection string, "Transaction pooler" mode).
# DATABASE_URL=postgresql://postgres.xxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
# Migrations: automatic on the production build on Vercel, when the Docker container starts, otherwise npm run db:migrate.
# BRAIN_MIGRATE_ON_BUILD=1     # also on a preview build (if it has its own database); =0: never on build
# DATABASE_MIGRATE_URL=…       # connection used to migrate, if it must differ from DATABASE_URL
# BRAIN_DATA_DIR=.brain
# Postgres without TLS (local Docker): DATABASE_SSL=disable (otherwise TLS is required outside localhost)
# DATABASE_SSL=disable

# --- Claude (status summary, onboarding, new zones) ---
# Each company pastes its own key in Team and access → Zones. This one is only a fallback (demo);
# with no key at all, local heuristics and no zone created automatically.
# ANTHROPIC_API_KEY=sk-ant-...
# Encrypts the companies' Claude keys in the database (otherwise: the brain's session secret). openssl rand -hex 32
# Do not change it afterwards: the keys already saved would become unreadable (to be entered again).
# BRAIN_SECRET_KEY=...

# --- Daily "new zones" job (Vercel Cron, 10am in BRAIN_TIMEZONE) ---
# Vercel sends it as `Authorization: Bearer …`; without it, /api/cron/new-zones stays closed. openssl rand -hex 32
# CRON_SECRET=...

# --- Public URL of the dashboard (used in the install prompt) ---
# BRAIN_PUBLIC_URL=https://brain.example.com

# --- Self-hosted brain on local HTTPS (deploy/local): certificate of the private authority, served on /ca.crt and pinned
# by its fingerprint in the install prompts ---
# BRAIN_CA_FILE=/caddy/caddy/pki/authorities/local/root.crt

# --- Demo mode: quick sign-in buttons on /login (fictional data only!) ---
# BRAIN_DEMO=1

# --- Create your company from the home page (/create): open by default ---
# BRAIN_SIGNUP=0          # closes creation (invitation-only brain)
# BRAIN_MAX_ORGS=200      # cap on created companies

# Time zone for automation detection and the time of the "new zones" job
# BRAIN_TIMEZONE=Europe/Paris

# --- Live stream (SSE) ---
# The stream is notified as soon as an event is inserted (local emitter with files, LISTEN/NOTIFY with Postgres) and keeps
# a spaced-out safety reread. BRAIN_EVENT_NOTIFY=0 turns LISTEN off (reread only); on Vercel it is off by
# default (=1 to force it). DATABASE_LISTEN_URL: direct connection if DATABASE_URL goes through a pooler in transaction
# mode (Supabase port 6543), which does not pass LISTEN through.
# BRAIN_EVENT_NOTIFY=1
# DATABASE_LISTEN_URL=postgresql://…:5432/postgres
# BRAIN_STREAM_POLL_MS=800
# BRAIN_STREAM_IDLE_POLL_MS=15000

# --- Monitoring ---
# Alert webhook (JSON { text }, compatible with Slack, Discord via /slack, Mattermost, n8n…): route errors,
# failed sync on a workstation, failed connector. At most one alert per cause per hour.
# BRAIN_ALERT_WEBHOOK=https://hooks.slack.com/services/…
# External probe: GET /api/health (200 if the storage answers, otherwise 503).

# --- Semantic search (optional): without a provider, search stays lexical (with synonyms) ---
# Voyage AI:
# VOYAGE_API_KEY=pa-…
# BRAIN_EMBEDDING_MODEL=voyage-4 (default; voyage-4-lite and voyage-4-large share its vectors)
# or any OpenAI-compatible /v1/embeddings endpoint (OpenAI, Mistral, local Ollama with nomic-embed-text…):
# BRAIN_EMBEDDING_URL=http://localhost:11434/v1/embeddings
# BRAIN_EMBEDDING_KEY=
# BRAIN_EMBEDDING_MODEL=nomic-embed-text
# After enabling: npm run embed (embeds what exists), npm run eval (measures search on the Encore demo).
