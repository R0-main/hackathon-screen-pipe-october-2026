# Self-hosted brain: HTTPS on the local network in front of the dashboard ("brain" service, port 3000).
# BRAIN_HOSTS: the brain's names and addresses ("localhost, 192.168.1.20, finance-desk.local"), all in the certificate.
# BRAIN_TLS  : "internal" (Caddy's private authority, root certificate served on /ca.crt) or "/certs/cert.pem /certs/key.pem".

{
	# The automatic HTTP → HTTPS redirects would come before our :80 block (and so before /ca.crt): we do them ourselves.
	auto_https disable_redirects
	# No need to install the authority in the container: the computers are the ones that trust it, through the prompt.
	skip_install_trust
}

{$BRAIN_HOSTS:localhost} {
	tls {$BRAIN_TLS:internal}
	encode gzip
	# The "Live agents" feed (/api/stream) is an SSE stream: no buffering.
	reverse_proxy brain:3000 {
		flush_interval -1
	}
}

# Port 80: the root certificate, to fetch before trusting HTTPS; everything else is redirected to HTTPS.
:80 {
	handle /ca.crt {
		root * /data/caddy/pki/authorities/local
		rewrite * /root.crt
		header Content-Type application/x-pem-file
		file_server
	}
	handle {
		redir https://{host}{uri} permanent
	}
}
