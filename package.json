{
  "name": "company-brain",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev -w @brain/web",
    "build": "npm run build -w @brain/web",
    "start": "npm run start -w @brain/web",
    "seed": "npm run seed -w @brain/web",
    "simulate": "npm run simulate -w @brain/web",
    "build:client": "npm run build -w @brain/client",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "smoke": "npm run smoke -w @brain/web",
    "eval": "npm run eval -w @brain/web",
    "embed": "npm run embed -w @brain/web",
    "db:migrate": "npm run db:migrate -w @brain/web"
  },
  "engines": {
    "node": ">=20"
  }
}
