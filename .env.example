# Configuration locale de NOS Brainer, lue par le Makefile (make dev).
# `make dev` copie ce fichier en .env la première fois : modifie .env, jamais celui-ci.
# Une valeur par ligne, sans guillemets ni commentaire en fin de ligne.

# --- Ports ---
# Port du dashboard : http://localhost:3000. Change-le s'il est déjà pris sur ton poste.
BRAIN_PORT=3000
# Port de Postgres sur ce poste. Change-le s'il est déjà pris (un autre Postgres, un autre projet).
POSTGRES_PORT=5432

# --- Base de données ---
# Postgres local créé par `make dev` : avec Docker s'il marche sans sudo, sinon un Postgres privé dans .local/postgres.
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=brain
# Base existante (Neon, Supabase, Postgres de l'école…) : renseigne son adresse ici et aucun Postgres local
# ne sera démarré. Laisser vide pour le Postgres local ci-dessus.
DATABASE_URL=

# --- Clés API, toutes optionnelles ---
# Claude côté serveur : « où en est la boîte » et l'onboarding rédigés par Claude. Sans clé : heuristiques locales.
ANTHROPIC_API_KEY=
# Recherche sémantique (embeddings Voyage). Sans clé : recherche plein texte.
VOYAGE_API_KEY=
# Alertes de supervision vers un webhook Slack.
BRAIN_ALERT_WEBHOOK=

# --- Divers ---
# Fuseau horaire pour la détection des automatisations.
BRAIN_TIMEZONE=Europe/Paris
