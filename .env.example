# Local configuration of NOS Brainer, read by the Makefile (make dev).
# `make dev` copies this file to .env the first time: edit .env, never this one.
# One value per line, with no quotes and no comment at the end of the line.

# --- Ports ---
# Dashboard port: http://localhost:3000. Change it if it is already taken on your computer.
BRAIN_PORT=3000
# Postgres port on this computer. Change it if it is already taken (another Postgres, another project).
POSTGRES_PORT=5432

# --- Database ---
# Local Postgres created by `make dev`: with Docker if it works without sudo, otherwise a private Postgres in .local/postgres.
POSTGRES_USER=brain
POSTGRES_PASSWORD=brain
POSTGRES_DB=brain
# Existing database (Neon, Supabase, the school's Postgres…): put its address here and no local Postgres
# will be started. Leave empty for the local Postgres above.
DATABASE_URL=

# --- API keys, all optional ---
# Claude on the server: "where the company stands" and onboarding written by Claude. Without a key: local heuristics.
ANTHROPIC_API_KEY=
# Semantic search (Voyage embeddings). Without a key: full-text search.
VOYAGE_API_KEY=
# Monitoring alerts to a Slack webhook.
BRAIN_ALERT_WEBHOOK=

# --- Misc ---
# Open the browser automatically on launch (0 to open nothing).
BRAIN_OPEN=1
# Time zone for automation detection.
BRAIN_TIMEZONE=Europe/Paris
